# Database Configuration
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/xmas_event
# For PostgreSQL: postgresql://username:password@localhost:5432/xmas_event

# JWT Secret (Change this to a strong random string in production!)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-this-in-production

# Environment
ENV=production

# CORS Origins (comma-separated)
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]

# Redis (Optional)
# REDIS_URL=redis://localhost:6379/0

# API Rate Limiting (Optional)
# RATE_LIMIT_PER_MINUTE=100

# Logging Level
LOG_LEVEL=INFO

# Timezone
TIMEZONE=Asia/Seoul

# Telegram (Optional)
# TELEGRAM_BOT_TOKEN=123456:abcdef...
# TELEGRAM_BOT_USERNAME=cc_jm_2026_bot
# TELEGRAM_WEBAPP_SHORT_NAME=your_webapp_short_name
# TELEGRAM_LINK_TOKEN_EXPIRE_MINUTES=10
# TELEGRAM_MINI_APP_URL=https://your-miniapp-domain.com
TELEGRAM_CHANNEL_USERNAME=-1003462656986

# Telegram Webhook mode (Optional - recommended for production to avoid getUpdates conflicts)
# TELEGRAM_USE_WEBHOOK=true
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com
# TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_WEBHOOK_LISTEN=0.0.0.0
# TELEGRAM_WEBHOOK_PORT=8080
# TELEGRAM_WEBHOOK_SECRET_TOKEN=change-me

# Telegram Channel Join (Frontend - Vite)
# - 링크 오픈용(초대 링크 또는 공개 username 링크)
# - 검증용은 백엔드의 TELEGRAM_CHANNEL_USERNAME(-100... 또는 @username)로도 동작하지만,
#   CC 채널이 별도일 경우 아래로 override 가능
# VITE_TELEGRAM_OFFICIAL_CHANNEL_URL=https://t.me/+your_invite
# VITE_TELEGRAM_CHANNEL_URL=https://t.me/+your_invite
# VITE_TELEGRAM_CC_CHANNEL_URL=https://t.me/+your_invite
# VITE_TELEGRAM_CHANNEL_USERNAME=@your_channel_username_or_-100chatid
# VITE_TELEGRAM_CC_CHANNEL_USERNAME=@your_channel_username_or_-100chatid
