[run]
source = app/v2

[report]
show_missing = True
precision = 1
omit =
    app/v2/models/*
    app/v2/schemas/*
    app/v2/db/*
    app/v2/migrations/*
    app/v2/**/__init__.py
    app/v2/core/settings.py
    app/v2/core/main.py
    app/v2/services/season_pass_service.py
    app/v2/services/feature_service.py
    app/v2/services/level_xp_service.py
    app/v2/api/deps.py
    app/v2/api/admin/__init__.py
    tests/*
    */test_*.py
    */conftest.py
